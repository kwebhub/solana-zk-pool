# ============================================================
# solana-zk-pool — example environment file
# ============================================================
# Copy to the right places:
#   cp .env.example services/backend/.env
#   cp .env.example web/.env
# and replace values with your own.
# ============================================================

# ---------- Solana ----------
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET=~/.config/solana/id.json

# ---------- Program IDs (devnet) ----------
PROGRAM_ID=C5Q4FjJ8zSD41FfMfcEccjnGnFJ7K44rDgnyrTx2fr6q
VERIFIER_PROGRAM_ID=AukfYGQqhv3ZkdB1G7cKF3djsE9FKMrAfLd34doSWQex

# ---------- Backend ----------
PORT=4001
RUST_LOG=info
PROVER_URL=http://localhost:4002
MERKLE_URL=http://localhost:4003

# ---------- Database ----------
DATABASE_URL=postgres://zkpool:zkpool_dev_password@localhost:5432/zkpool
REDIS_URL=redis://localhost:6379

# ---------- Pool ----------
# PDA: ["pool3"] from PROGRAM_ID
# Update after `anchor deploy` — find via:
#   solana find-program-derived-address <PROGRAM_ID> string:pool3
POOL_ADDRESS=GXbvPQrChj5T4PhV17CzgVKX54tk6f6aRCwTmMbSQSun

# ---------- Frontend (Vite) ----------
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=C5Q4FjJ8zSD41FfMfcEccjnGnFJ7K44rDgnyrTx2fr6q
VITE_VERIFIER_PROGRAM_ID=AukfYGQqhv3ZkdB1G7cKF3djsE9FKMrAfLd34doSWQex
VITE_API_URL=http://localhost:4001
VITE_MERKLE_URL=http://localhost:4003
VITE_MERKLE_TREE_DEPTH=20
VITE_MIN_DEPOSIT=0.001

# ---------- Prover ----------
PROVER_PORT=4002

# ---------- Merkle ----------
MERKLE_PORT=4003

# ---------- Indexer ----------
INDEXER_POLL_INTERVAL_SECS=5
INDEXER_PAGE_SIZE=100
INDEXER_MAX_PAGES=10

# ---------- Rate limiting ----------
RATE_LIMIT_WITHDRAW_PER_MIN=5
RATE_LIMIT_READ_PER_MIN=60

# ---------- Merkle tree ----------
MERKLE_TREE_DEPTH=20
